#!/bin/bash
# Ralph Wiggum Loop - main executable
#
# Usage:
#   ralph plan [max_iterations]
#   ralph build [max_iterations]
#   ralph align-specs [max_iterations]
#   ralph prompt <file> [max_iterations]
#   ralph update
#   ralph sandbox <setup|up|stop|reset|shell|status>

set -euo pipefail

# ---------------------------------------------------------------------------
# Self-relative path resolution
# ---------------------------------------------------------------------------
RALPH_DIR="$(dirname "$(readlink -f "$0")")"
RALPH_HOME="$(realpath --relative-to=. "$RALPH_DIR")"

# ---------------------------------------------------------------------------
# Defaults (may be overridden by config)
# ---------------------------------------------------------------------------
DEFAULT_MAX_ITERATIONS=10
MAX_RETRIES=3
SPECS_DIR="specs"

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
MODE=""
MAX_ITERATIONS=""
PROMPT_FILE=""
SANDBOX_ARGS=()
PROCESS_FLAG=0
HELP_TOPIC=""

usage() {
    cat <<EOF
Usage: ralph <mode> [max_iterations]

Modes:
  help                                 Overview and list of help topics
  help   [topic]                       Show operational guidance on a topic
  plan   [max_iterations]              Run gap-driven plan mode iterations
  plan   --process [max_iterations]    Run process plan mode iterations
  build  [max_iterations]              Run build mode iterations
  align-specs [max_iterations]         Update target-state specs after process migration
  prompt <file> [max_iterations]       Run an ad-hoc prompt from file in the loop
  update                               Update ralph to the latest upstream version
  version                              Print the installed ralph version (upstream commit)
  sandbox setup [--force]              Generate sandbox files by prompting the agent
  sandbox up                           Start the sandbox container
  sandbox stop                         Stop the sandbox container
  sandbox reset [--all]                Re-clone codebase (--all: delete all volumes)
  sandbox shell                        Open a bash shell inside the container
  sandbox status                       Show sandbox container status
  sandbox name [service]               Print the resolved container name (default: app)

Examples:
  ralph help
  ralph help sandbox
  ralph plan
  ralph build 20
  ralph prompt prompts/my-prompt.md

Run 'ralph help' for an overview and guides.

https://github.com/mjeffe/ralph-loop
EOF
}

# .version is written by install.sh/update.sh; a source checkout reports its own HEAD
print_version() {
    if [[ -f "$RALPH_DIR/.version" ]]; then
        echo "ralph $(cat "$RALPH_DIR/.version")"
    elif [[ -d "$RALPH_DIR/.git" ]]; then
        echo "ralph $(git -C "$RALPH_DIR" rev-parse --short HEAD) (source checkout)"
    else
        echo "ralph (unknown version)"
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        plan|build|align-specs|prompt|update|sandbox|help)
            if [[ "$MODE" == "help" ]]; then
                HELP_TOPIC="$1"
            else
                MODE="$1"
            fi
            shift
            ;;
        --process)
            PROCESS_FLAG=1
            shift
            continue
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        version|--version)
            print_version
            exit 0
            ;;
        *)
            if [[ -z "$MODE" ]]; then
                echo "Error: unknown option or mode: $1" >&2
                usage >&2
                exit 1
            fi
            if [[ "$MODE" == "help" ]]; then
                HELP_TOPIC="$1"
            elif [[ "$MODE" == "sandbox" ]]; then
                SANDBOX_ARGS+=("$1")
            elif [[ "$MODE" == "prompt" && -z "$PROMPT_FILE" ]]; then
                PROMPT_FILE="$1"
            else
                MAX_ITERATIONS="$1"
            fi
            shift
            ;;
    esac
done

if [[ -z "$MODE" ]]; then
    usage
    exit 1
fi

if [[ "$PROCESS_FLAG" -eq 1 && "$MODE" != "plan" ]]; then
    echo "Error: --process is only valid with 'ralph plan'." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Load configuration
# ---------------------------------------------------------------------------
CONFIG_FILE="$RALPH_DIR/config"

if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Error: config file not found: $CONFIG_FILE" >&2
    exit 1
fi

# shellcheck source=/dev/null
source "$CONFIG_FILE"

: "${MAX_ITERATIONS:=${DEFAULT_MAX_ITERATIONS:-10}}"

# ---------------------------------------------------------------------------
# Load sandbox module
# ---------------------------------------------------------------------------
# shellcheck source=/dev/null
source "$RALPH_DIR/lib/sandbox.sh"

# ---------------------------------------------------------------------------
# Load agent script
# ---------------------------------------------------------------------------
if [[ "$MODE" != "update" && "$MODE" != "sandbox" && "$MODE" != "help" ]]; then
    AGENT_SCRIPT="$RALPH_DIR/agents/${AGENT}.sh"
    if [[ ! -f "$AGENT_SCRIPT" ]]; then
        echo "Error: agent script not found: $AGENT_SCRIPT" >&2
        exit 1
    fi
    # shellcheck source=/dev/null
    source "$AGENT_SCRIPT"
fi

# ---------------------------------------------------------------------------
# Prerequisite validation
# ---------------------------------------------------------------------------
# Exits unless lib/format_output.py can parse the agent's output (also used by sandbox setup).
require_output_format() {
    if [[ -z "${AGENT_OUTPUT_FORMAT:-}" ]]; then
        echo "Error: agents/${AGENT}.sh does not set AGENT_OUTPUT_FORMAT: its output parser is not" \
            "implemented yet (see specs/tech-debt.md item 7 in the ralph-loop repo)." >&2
        exit 1
    fi
    if ! command -v python3 &>/dev/null; then
        echo "Error: python3 not found in PATH (required by lib/format_output.py)" >&2
        exit 1
    fi
}

validate_prerequisites() {
    [[ "$MODE" == "sandbox" || "$MODE" == "help" ]] && return

    if [[ ! -d ".git" ]]; then
        echo "Error: not a git repository (no .git directory found)" >&2
        exit 1
    fi

    [[ "$MODE" == "update" ]] && return

    require_output_format

    if ! command -v "$AGENT_CLI" &>/dev/null; then
        echo "Error: agent CLI not found in PATH: $AGENT_CLI" >&2
        exit 1
    fi

    if [[ ! -d "$SPECS_DIR" ]]; then
        echo "Error: specs directory not found: $SPECS_DIR" >&2
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# Session log initialization
# ---------------------------------------------------------------------------
init_session_log() {
    local log_dir="$RALPH_DIR/logs"
    mkdir -p "$log_dir"
    SESSION_LOG="$log_dir/session-$(date +%Y%m%d-%H%M%S)-${MODE}.log"
    touch "$SESSION_LOG"
}

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
log() {
    echo "$*" | tee -a "$SESSION_LOG"
}

# ---------------------------------------------------------------------------
# Template variable substitution
# ---------------------------------------------------------------------------
prepare_prompt() {
    local template_file="$1"
    local output_file="$2"
    export MODE SPECS_DIR RALPH_HOME
    export PROCESS_DIR="${PROCESS_DIR:-}"
    export PLAN_HEADER TASK_OVERVIEW SELECTED_TASK ADJACENT_CONTEXT
    envsubst < "$template_file" > "$output_file"
}

# ---------------------------------------------------------------------------
# Implementation plan access — all plan parsing goes through lib/plan-filter.sh
# ---------------------------------------------------------------------------
PLAN_FILE="$RALPH_DIR/implementation_plan.md"

plan_filter() {
    bash "$RALPH_DIR/lib/plan-filter.sh" "$1" "$PLAN_FILE" "${@:2}"
}

plan_meta() {
    plan_filter meta "$1" 2>/dev/null || true
}

plan_type() {
    local plan_type
    plan_type=$(plan_meta "Plan Type")
    echo "${plan_type,,}"
}

# Print plan format problems and return 1 if the plan is not in the format ralph parses
validate_plan() {
    local problems
    problems=$(plan_filter validate 2>&1) && return 0
    echo "Error: implementation_plan.md is not in the format ralph parses:"
    echo "$problems" | sed 's/^/  - /'
    return 1
}

# ---------------------------------------------------------------------------
# Build mode: validate the plan and refresh injected plan slices.
# Called before every build iteration so prompts reflect prior iterations' plan updates.
# Returns:
#   0 - context refreshed (task selected, or gap-driven plan)
#   1 - plan failed validation
#   2 - process plan: no eligible task, all tasks complete
#   3 - process plan: no eligible task, blocked/unready tasks remain
# ---------------------------------------------------------------------------
refresh_plan_context() {
    local problems select_output
    if ! problems=$(validate_plan); then
        log "$problems"
        return 1
    fi

    PLAN_HEADER=$(plan_filter header 2>/dev/null || true)
    TASK_OVERVIEW=$(plan_filter overview 2>/dev/null || true)
    SELECTED_TASK=""
    ADJACENT_CONTEXT=""

    [[ "$(plan_type)" == "process" ]] || return 0

    select_output=$(plan_filter select) || return 1
    if [[ "$select_output" == "NO_ELIGIBLE_TASK" ]]; then
        [[ "$(plan_filter summary)" == "planned=0 blocked=0 "* ]] && return 2
        return 3
    fi
    SELECTED_TASK=$(echo "$select_output" | sed -n '/^---SELECTED_TASK---$/,/^---END_SELECTED_TASK---$/{ /^---.*---$/d; p; }')
    ADJACENT_CONTEXT=$(echo "$select_output" | sed -n '/^---ADJACENT_CONTEXT---$/,/^---END_ADJACENT_CONTEXT---$/{ /^---.*---$/d; p; }')
    return 0
}

log_replan_hint() {
    local message="$1" plan_cmd
    plan_cmd=$(plan_meta "Plan Command")
    [[ -z "$plan_cmd" ]] && plan_cmd="ralph plan"
    log "${message} Run '${plan_cmd}' to regenerate the implementation plan."
}

# ---------------------------------------------------------------------------
# Iteration summary (written by lib/format_output.py)
# ---------------------------------------------------------------------------
# Prints one field of the format_output summary JSON; empty for null or a missing file.
summary_field() {
    jq -r --arg k "$2" '.[$k] | if . == null then "" else tostring end' "$1" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Run a single iteration (with retries)
# Returns:
#   0 - success, continue looping
#   1 - retries exhausted
#   2 - completion signal detected
#   3 - replan signal detected
# ---------------------------------------------------------------------------
run_iteration() {
    local iteration="$1"
    local prompt_template="$2"
    local retry=0

    while [[ $retry -le $MAX_RETRIES ]]; do
        local iter_start
        iter_start=$(date +%s)

        log "================================================================================"
        log "ITERATION ${iteration}  $(date '+%Y-%m-%d %H:%M:%S')"
        log "mode: ${MODE}  prompt: ${prompt_template}"
        log "================================================================================"

        local tmp_prompt
        tmp_prompt=$(mktemp)
        prepare_prompt "$prompt_template" "$tmp_prompt"

        type agent_pre_iteration &>/dev/null && agent_pre_iteration

        local summary_file agent_rc=0
        summary_file=$(mktemp)
        agent_invoke "$tmp_prompt" \
            | tee "$RALPH_DIR/last_agent_output" \
            | python3 "$RALPH_DIR/lib/format_output.py" --format "$AGENT_OUTPUT_FORMAT" \
                --summary "$summary_file" --log "$SESSION_LOG" \
            || agent_rc=$?

        rm -f "$tmp_prompt"

        local signal response_chars cost
        signal=$(summary_field "$summary_file" signal)
        response_chars=$(summary_field "$summary_file" response_chars)
        cost=$(summary_field "$summary_file" cost)
        _ITER_CONTEXT_USED=$(summary_field "$summary_file" context_used)
        _ITER_CONTEXT_MAX=$(summary_field "$summary_file" context_max)
        _ITER_CONTEXT_PCT=$(summary_field "$summary_file" context_pct)

        # A missing signal is normal. No response (budget exhaustion, auth failure, transient error,
        # or a crashed processor that wrote no summary) and a reported agent error are failures.
        if [[ $agent_rc -eq 0 ]]; then
            if [[ "$(summary_field "$summary_file" is_error)" == "true" ]]; then
                log "Agent reported an error: $(summary_field "$summary_file" error)"
                agent_rc=1
            elif [[ -z "$response_chars" || "$response_chars" == "0" ]]; then
                log "⚠ Agent produced no response — possible budget exhaustion or transient failure"
                agent_rc=1
            fi
        fi

        log "================================================================================"
        local duration=$(( $(date +%s) - iter_start ))
        log "ITERATION ${iteration} DONE in ${duration}s ----"

        if [[ -n "$_ITER_CONTEXT_USED" && -n "$_ITER_CONTEXT_MAX" ]]; then
            log "Context: ${_ITER_CONTEXT_USED}/${_ITER_CONTEXT_MAX} tokens (${_ITER_CONTEXT_PCT}%)"
        elif [[ -n "$_ITER_CONTEXT_USED" ]]; then
            log "Context: ${_ITER_CONTEXT_USED} tokens"
        fi
        [[ -n "$cost" ]] && log "Iteration Cost: \$$(printf '%.4f' "$cost")"

        # Hooks may log out-of-band data (e.g. amp balance) and may override _ITER_CONTEXT_*.
        # shellcheck disable=SC2034  # read by agent_post_iteration
        RALPH_ITER_SUMMARY="$summary_file"
        type agent_post_iteration &>/dev/null && agent_post_iteration
        rm -f "$summary_file"

        if [[ -n "$_ITER_CONTEXT_PCT" && "$_ITER_CONTEXT_PCT" -ge "${CONTEXT_WARN_PCT:-80}" ]]; then
            log "⚠ Context usage high — agent quality may degrade"
        fi
        log "================================================================================"

        if [[ $agent_rc -ne 0 ]]; then
            retry=$(( retry + 1 ))
            if [[ $retry -le $MAX_RETRIES ]]; then
                log "Agent failure, retry ${retry}/${MAX_RETRIES}..."
                continue
            fi
            return 1
        fi

        case "$signal" in
            COMPLETE) return 2 ;;
            REPLAN) return 3 ;;
            *) return 0 ;;
        esac
    done

    return 1
}

# ---------------------------------------------------------------------------
# Main loop
# ---------------------------------------------------------------------------
run_loop() {
    local prompt_template="$1"
    local session_start iteration=0 success=0 failures=0
    local exit_reason="max iterations reached" exit_code=0
    local context_min="" context_max="" context_sum=0 context_count=0 context_window=""
    local task_heading prev_task_heading=""
    session_start=$(date +%s)

    while [[ $iteration -lt $MAX_ITERATIONS ]]; do
        if [[ "$MODE" == "build" ]]; then
            local plan_rc=0
            refresh_plan_context || plan_rc=$?
            case $plan_rc in
                1) exit_reason="invalid plan"; exit_code=1; break ;;
                2) exit_reason="all tasks complete"; break ;;
                3) exit_reason="no eligible task"; exit_code=3
                   log_replan_hint "No eligible task: remaining tasks are blocked or depend on blocked tasks."
                   break ;;
            esac

            # A build iteration must complete or block its task; re-selecting it means no progress
            task_heading="${SELECTED_TASK%%$'\n'*}"
            if [[ -n "$task_heading" && "$task_heading" == "$prev_task_heading" ]]; then
                log "⚠ '${task_heading}' selected again: previous iteration neither completed nor blocked it"
                exit_reason="no progress"; exit_code=6
                break
            fi
            prev_task_heading="$task_heading"
        fi

        iteration=$(( iteration + 1 ))
        _ITER_CONTEXT_USED="" _ITER_CONTEXT_MAX="" _ITER_CONTEXT_PCT=""

        local rc=0
        run_iteration "$iteration" "$prompt_template" || rc=$?

        if [[ -n "${_ITER_CONTEXT_PCT:-}" ]]; then
            context_count=$(( context_count + 1 ))
            context_sum=$(( context_sum + _ITER_CONTEXT_PCT ))
            context_window="${_ITER_CONTEXT_MAX}"
            if [[ -z "$context_min" || "$_ITER_CONTEXT_PCT" -lt "$context_min" ]]; then
                context_min=$_ITER_CONTEXT_PCT
            fi
            if [[ -z "$context_max" || "$_ITER_CONTEXT_PCT" -gt "$context_max" ]]; then
                context_max=$_ITER_CONTEXT_PCT
            fi
        fi

        case $rc in
            0) success=$(( success + 1 )) ;;
            2) success=$(( success + 1 )); exit_reason="completion signal"; break ;;
            3) success=$(( success + 1 )); exit_reason="replan signal"; exit_code=3
               log_replan_hint "Agent requested re-planning."
               break ;;
            *) failures=$(( failures + 1 )); exit_reason="agent failure exceeded retries"; exit_code=4
               break ;;
        esac
    done

    # A finished plan must be parseable by build mode; catch format drift now, not at build time
    if [[ "$MODE" == "plan" && "$exit_reason" == "completion signal" ]]; then
        local problems
        if ! problems=$(validate_plan); then
            log "$problems"
            exit_reason="completion signal, but plan is invalid"; exit_code=1
        fi
    fi

    log "================================================================================"
    log "SESSION SUMMARY"
    log "================================================================================"
    log "Iterations: ${iteration}  Successful: ${success}  Failed: ${failures}"
    log "Duration: $(( $(date +%s) - session_start ))s"
    if [[ "$context_count" -gt 0 ]]; then
        local context_avg
        context_avg=$(( context_sum / context_count ))
        log "Context: min ${context_min}% / avg ${context_avg}% / max ${context_max}%  (window: ${context_window} tokens)"
    fi
    log "Exit: ${exit_reason} (code ${exit_code})"
    log "================================================================================"

    if [[ "$MODE" == "build" && ( "$exit_reason" == "completion signal" || "$exit_reason" == "all tasks complete" ) ]]; then
        if [[ "$(plan_type)" == "process" ]]; then
            log ""
            log "╔══════════════════════════════════════════════════════════════════════════════════╗"
            log "║  Process-plan build complete. Target-state specs may need updating.            ║"
            log "║  Run: ralph align-specs                                                       ║"
            log "╚══════════════════════════════════════════════════════════════════════════════════╝"
        fi
    fi

    exit "$exit_code"
}

# ---------------------------------------------------------------------------
# Help system
# ---------------------------------------------------------------------------
ralph_help() {
    local topic="${1:-}"
    local help_dir="$RALPH_DIR/lib/help"
    if [[ -z "$topic" ]]; then
        cat "$help_dir/overview.txt"
        echo
        cat "$help_dir/index.txt"
    elif [[ -f "$help_dir/${topic}.txt" ]]; then
        cat "$help_dir/${topic}.txt"
    else
        echo "Unknown help topic: $topic" >&2; echo
        cat "$help_dir/index.txt"
    fi
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
validate_prerequisites

if [[ "$MODE" == "help" ]]; then
    ralph_help "$HELP_TOPIC"
    exit 0
fi

case "$MODE" in
    plan)
        if [[ "$PROCESS_FLAG" -eq 1 ]]; then
            if [[ -z "${PROCESS_DIR:-}" ]]; then
                echo "Error: No PROCESS_DIR configured. Set PROCESS_DIR in config." >&2
                exit 1
            fi
            if [[ ! -d "$PROCESS_DIR" ]]; then
                echo "Error: PROCESS_DIR '${PROCESS_DIR}' not found." >&2
                exit 1
            fi
            if ! ls "$PROCESS_DIR"/*.md &>/dev/null; then
                echo "Error: No process specs found in '${PROCESS_DIR}/'." >&2
                exit 1
            fi

            SPEC_BYTES=$(cat "$PROCESS_DIR"/*.md 2>/dev/null | wc -c)
            SPEC_COUNT=$(find "$PROCESS_DIR" -maxdepth 1 -name '*.md' | wc -l)
            SPEC_KB=$(( SPEC_BYTES / 1024 ))
            if [[ "$SPEC_KB" -lt 50 && "$SPEC_COUNT" -lt 5 ]]; then
                SPEC_VOLUME_HINT="Total process spec volume: ${SPEC_COUNT} files, ~${SPEC_KB} KB. You can likely complete planning in one iteration."
            else
                SPEC_VOLUME_HINT="Total process spec volume: ${SPEC_COUNT} files, ~${SPEC_KB} KB. This exceeds single-iteration capacity. Use the decomposition ledger and process one spec file per iteration."
            fi
            export SPEC_VOLUME_HINT

            PROMPT_TEMPLATE="$RALPH_DIR/prompts/plan-process.md"
        else
            PROMPT_TEMPLATE="$RALPH_DIR/prompts/plan.md"
        fi
        if [[ ! -f "$PROMPT_TEMPLATE" ]]; then
            echo "Error: plan prompt template not found: $PROMPT_TEMPLATE" >&2
            exit 1
        fi
        init_session_log
        run_loop "$PROMPT_TEMPLATE"
        ;;

    build)
        if [[ ! -f "$PLAN_FILE" ]]; then
            echo "Implementation plan not found. Run 'ralph plan' first." >&2
            exit 2
        fi
        validate_plan >&2 || exit 1

        # Plan slices (header, overview, selected task) are refreshed per iteration in run_loop
        if [[ "$(plan_type)" == "process" ]]; then
            PROMPT_TEMPLATE="$RALPH_DIR/prompts/build-process.md"
        else
            PROMPT_TEMPLATE="$RALPH_DIR/prompts/build.md"
        fi
        if [[ ! -f "$PROMPT_TEMPLATE" ]]; then
            echo "Error: build prompt template not found: $PROMPT_TEMPLATE" >&2
            exit 1
        fi
        init_session_log
        run_loop "$PROMPT_TEMPLATE"
        ;;

    align-specs)
        if [[ -z "${PROCESS_DIR:-}" ]]; then
            echo "Error: align-specs requires process specs. Set PROCESS_DIR in config." >&2
            exit 1
        fi
        if [[ ! -f "$PLAN_FILE" ]]; then
            echo "Error: align-specs requires a process-type implementation plan. Run 'ralph plan --process' and 'ralph build' first." >&2
            exit 1
        fi
        validate_plan >&2 || exit 1
        if [[ "$(plan_type)" != "process" ]]; then
            echo "Error: align-specs requires a process-type implementation plan. Run 'ralph plan --process' and 'ralph build' first." >&2
            exit 1
        fi
        if [[ "$(plan_filter summary)" == *" complete=0" ]]; then
            echo "Error: align-specs requires completed build work. Run 'ralph build' first." >&2
            exit 1
        fi
        PROMPT_TEMPLATE="$RALPH_DIR/prompts/align-specs.md"
        if [[ ! -f "$PROMPT_TEMPLATE" ]]; then
            echo "Error: align-specs prompt template not found: $PROMPT_TEMPLATE" >&2
            exit 1
        fi
        init_session_log
        run_loop "$PROMPT_TEMPLATE"
        ;;

    prompt)
        if [[ -z "$PROMPT_FILE" ]]; then
            echo "Error: prompt mode requires a file argument" >&2
            usage >&2
            exit 1
        fi
        if [[ ! -f "$PROMPT_FILE" ]]; then
            echo "Error: prompt file not found: $PROMPT_FILE" >&2
            exit 1
        fi
        if ! grep -qF '<promise>COMPLETE</promise>' "$PROMPT_FILE"; then
            echo "Error: prompt file must contain <promise>COMPLETE</promise>" >&2
            exit 1
        fi
        init_session_log
        run_loop "$PROMPT_FILE"
        ;;

    update)
        echo "Fetching update script from GitHub..."
        curl -sSL https://raw.githubusercontent.com/mjeffe/ralph-loop/main/update.sh | bash
        ;;

    sandbox)
        if [[ "${SANDBOX:-}" == "1" ]]; then
            echo "Error: already inside the sandbox. Run ralph commands directly." >&2
            exit 1
        fi
        sandbox_sub="${SANDBOX_ARGS[0]:-}"
        sandbox_extra=()
        [[ ${#SANDBOX_ARGS[@]} -gt 1 ]] && sandbox_extra=("${SANDBOX_ARGS[@]:1}")
        case "$sandbox_sub" in
            setup)  sandbox_setup "${sandbox_extra[@]+"${sandbox_extra[@]}"}" ;;
            up)     sandbox_up "${sandbox_extra[@]+"${sandbox_extra[@]}"}" ;;
            stop)   sandbox_stop "${sandbox_extra[@]+"${sandbox_extra[@]}"}" ;;
            reset)  sandbox_reset "${sandbox_extra[@]+"${sandbox_extra[@]}"}" ;;
            shell)  sandbox_shell "${sandbox_extra[@]+"${sandbox_extra[@]}"}" ;;
            status) sandbox_status "${sandbox_extra[@]+"${sandbox_extra[@]}"}" ;;
            name)   sandbox_name "${sandbox_extra[@]+"${sandbox_extra[@]}"}" ;;
            *)
                echo "Usage: ralph sandbox <setup|up|stop|reset|shell|status|name>"
                exit 1
                ;;
        esac
        ;;

    *)
        echo "Error: unknown mode: $MODE" >&2
        usage >&2
        exit 1
        ;;
esac
